{
  "name": "moumantai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript src/features/context/generated/openapi.json -o src/features/context/generated/api.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  }
}
