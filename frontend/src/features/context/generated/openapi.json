  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ApiError"
      },
      "Attachment": {
        "properties": {
          "attachment_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Attachment Id"
          },
          "filename": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Media Type"
          },
          "size_bytes": {
            "type": "integer",
            "maximum": 25000000.0,
            "minimum": 0.0,
            "title": "Size Bytes"
          },
          "evidence_ref": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Evidence Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attachment_id",
          "filename",
          "media_type",
          "size_bytes",
          "evidence_ref"
        ],
        "title": "Attachment"
      },
      "BusinessContext": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant Id"
          },
          "context_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Context Id"
          },
          "source_message_ids": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Source Message Ids"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "customer_identity_status": {
            "type": "string",
            "enum": [
              "LINK_VERIFIED",
              "UNVERIFIED",
              "AMBIGUOUS"
            ],
            "title": "Customer Identity Status"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "requested_items": {
            "items": {
              "$ref": "#/components/schemas/RequestedItem"
            },
            "type": "array",
            "title": "Requested Items"
          },
          "requested_delivery_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Delivery At"
          },
          "field_evidence": {
            "additionalProperties": {
              "items": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              "type": "array"
            },
            "type": "object",
            "title": "Field Evidence"
          },
          "conflicts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Conflicts"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields"
          },
          "context_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Context Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY",
              "PARTIAL",
              "CONFLICT",
              "UNRESOLVED"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "context_id",
          "source_message_ids",
          "customer_identity_status",
          "context_version",
          "status"
        ],
        "title": "BusinessContext"
      },
      "ContextReview": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant Id"
          },
          "context_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Context Id"
          },
          "review_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Review Id"
          },
          "expected_context_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Context Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_REQUIRED",
              "PENDING",
              "ACCEPTED",
              "CORRECTED",
              "UNRESOLVED"
            ],
            "title": "Status"
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "context_id",
          "review_id",
          "expected_context_version",
          "status"
        ],
        "title": "ContextReview"
      },
      "DevelopmentContext": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "LOCAL_SYNTHETIC_ONLY",
            "title": "Mode",
            "default": "LOCAL_SYNTHETIC_ONLY"
          },
          "tenant_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant Id"
          },
          "implemented_channel": {
            "type": "string",
            "const": "WHATSAPP",
            "title": "Implemented Channel",
            "default": "WHATSAPP"
          },
          "authentication": {
            "type": "string",
            "const": "NOT_IMPLEMENTED",
            "title": "Authentication",
            "default": "NOT_IMPLEMENTED"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id"
        ],
        "title": "DevelopmentContext"
      },
      "ExtractedField": {
        "properties": {
          "field_name": {
            "type": "string",
            "enum": [
              "customer_id",
              "sku",
              "quantity",
              "unit",
              "requested_delivery_at",
              "special_instructions",
              "order_id"
            ],
            "title": "Field Name"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "VALID",
              "MISSING",
              "INVALID",
              "UNRESOLVED",
              "CONFLICT"
            ],
            "title": "Validation Status"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/FieldEvidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "corrected_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected By"
          },
          "qualifier": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EXACT",
                  "DEADLINE",
                  "DATE_ONLY"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Qualifier"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field_name",
          "value",
          "validation_status"
        ],
        "title": "ExtractedField"
      },
      "ExtractionAttemptRecord": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Attempt Id"
          },
          "tenant_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant Id"
          },
          "message_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Message Id"
          },
          "extractor_version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Extractor Version"
          },
          "input_content_sha256": {
            "type": "string",
            "title": "Input Content Sha256"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "PROCESSED",
              "PROCESSING_FAILED"
            ],
            "title": "Status"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ExtractedField"
            },
            "type": "array",
            "title": "Fields"
          },
          "diagnostic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagnostic"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "tenant_id",
          "message_id",
          "extractor_version",
          "input_content_sha256",
          "status",
          "started_at"
        ],
        "title": "ExtractionAttemptRecord"
      },
      "ExtractionHistoryResponse": {
