# =============================================================================
# MouManTAI — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and adjust variables for your local development environment:
#     copy .env.example .env     (Windows PowerShell / CMD)
#     cp .env.example .env       (Linux / macOS)
#
# SECURITY RULES:
# - This template contains variable names and placeholders ONLY.
# - NEVER commit real passwords, secret tokens, or private keys to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Docker)
# -----------------------------------------------------------------------------
POSTGRES_DB=moumantai
POSTGRES_USER=moumantai
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full SQLAlchemy Database Connection URL
# For Docker Compose / Local PostgreSQL:
DATABASE_URL=postgresql+psycopg://moumantai:replace_with_local_postgres_password@localhost:5433/moumantai

# For Local SQLite testing / development (fallback):
# DATABASE_URL=sqlite:///./test_live.db

# -----------------------------------------------------------------------------
# Backend API & Server Settings (FastAPI / Uvicorn)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated list for Vite dev servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend Client Settings (Vite / React)
# -----------------------------------------------------------------------------
# Base URL for frontend API calls
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# P1 Context Intelligence & AI Inference Engine (RunPod Serverless / Remote GPU)
# -----------------------------------------------------------------------------
# Enable AI model extraction pipeline (true = AI extraction, false = deterministic rules fallback)
P1_AI_ENABLED=true

# Inference endpoint mode: 'runpod' (RunPod Serverless asynchronous queue) or 'direct' (standard synchronous HTTP)
P1_AI_ENDPOINT_MODE=runpod

# RunPod Serverless API URL (/run endpoint)
P1_AI_ENDPOINT_URL=https://api.runpod.ai/v2/replace_with_runpod_endpoint_id/run

# RunPod API Key for authentication (format: rpa_...)
P1_AI_API_KEY=replace_with_runpod_api_key

# Active inference stages to run in sequence (comma-separated: gliner,qwen)
P1_AI_STAGES=gliner,qwen

# Database URLs specifically used by P1 services and tests
P1_DATABASE_URL=postgresql+psycopg://moumantai:replace_with_local_postgres_password@localhost:5433/moumantai
P1_TEST_DATABASE_URL=postgresql+psycopg://moumantai:replace_with_local_postgres_password@localhost:5433/moumantai_test

# -----------------------------------------------------------------------------
# Outbox Worker & Integration Engine
# -----------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL=1.0
INTEGRATION_MODE=SYNTHETIC

# Live-API smoke test switch (0 = unit/mock only, 1 = run real HTTP smoke against port 8000)
LIVE_API=0
