+  receivedAt: '2026-10-24T00:00:00Z', lines: [{ product: 'Synthetic bread' }],
+  channel: 'Telegram', priority: 'High', risk: 'Unknown', size: 'Small', evidenceTier: 'SYNTHETIC',
